      },
      "search": {
        "page": "https://novelfire.net/search?keyword={query}",
        "fetchMode": "http",
        "item": "ul.novel-list li.novel-item",
        "title": "a@title, .novel-title",
        "link": "a@href",
        "cover": "img@data-src|src",
        "chapters": ".novel-stats ~ ([\\d,]+)\\s*Chapters",
        "verified": "Verified 2026-11-25 over plain HTTP."
      }
    },
    {
      "id": "webnovel",
      "name": "Webnovel",
      "domains": [
        "webnovel.com"
      ],
      "status": "browser-only",
      "fetchMode": "browser",
      "home": "https://www.webnovel.com",
      "example": "https://www.webnovel.com/book/32824130400116105",
