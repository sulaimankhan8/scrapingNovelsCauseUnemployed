      },
      "search": {
        "page": "https://www.webnovel.com/search?keywords={query}",
        "fetchMode": "browser",
        "item": "li:has(a.g_thumb[data-search-type='book'])",
        "title": "h3 a@title, h3 a",
        "link": "h3 a@href",
        "cover": "a.g_thumb img@data-original|src",
        "verified": "Verified 2026-11-25: the page answers curl, but WebNovel refuses the app's own HTTP client, so search goes through the site browser. The results page doesn't show chapter counts."
      }
    },
