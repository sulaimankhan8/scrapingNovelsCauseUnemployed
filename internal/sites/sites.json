      "input": {
        "novelUrl": "^https?://(www\\.)?webnovel\\.com/book/(?:[a-z0-9-]+_)?(?<id>\\d+)/?$",
        "chapterUrl": "^https?://(www\\.)?webnovel\\.com/book/(?:[a-z0-9-]+_)?(?<id>\\d+)/(?:[a-z0-9-]+_)?\\d+",
        "novelFromChapter": "id -> https://www.webnovel.com/book/{id}"
      },
      "novel": {
        "title": "meta[property='og:title']@content",
        "author": "meta[property='og:author']@content",
        "cover": "meta[property='og:image']@content",
        "description": "meta[property='og:description']@content",
        "tags": "meta[property='og:tag']@content"
      },
      "toc": {
        "strategy": "inline",
        "pageUrl": "{novelUrl}/catalog",
